# Copy to .env and fill in real values before running.

# Random long random string used to sign admin session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file path (relative to project root, or absolute in production)
DATABASE_URL=sqlite:///./johns_joyful_gifts.db

# Folder where uploaded product images are stored
UPLOAD_DIR=./uploads

# Max upload size for a single product image, in bytes (default 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Store defaults (all of these are also editable later from /admin/settings)
STORE_NAME=John's Joyful Gifts
STORE_TAGLINE=Joyful Gifts for Every Little Moment
WHATSAPP_NUMBER=+910000000000
INSTAGRAM_URL=https://instagram.com/
DEFAULT_DELIVERY_CHARGE=49
FREE_DELIVERY_THRESHOLD=999

# Set to "production" to enable secure (HTTPS-only) cookies
ENVIRONMENT=development

# Optional: online payment via Razorpay. Leave both blank to run
# Cash-on-Delivery only (the "Pay Online" option simply won't appear).
# Get test-mode keys free at https://dashboard.razorpay.com/app/keys
# after signing up (Test Mode toggle, top-right) -- no real bank
# account needed to test. See README.md "Online Payment (Razorpay)".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
