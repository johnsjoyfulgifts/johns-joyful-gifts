# Copy to .env and fill in real values before running.

# Random long random string used to sign admin session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Supabase Postgres connection string. Use the "Session pooler" URL from
# Project Settings -> Database (the direct connection is IPv6-only and won't
# resolve on most networks/hosts). Note the "+psycopg" driver suffix, needed
# since this app uses psycopg3, not the older psycopg2:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase project URL and service_role "secret" key (Project Settings -> API),
# used for Storage uploads. Server-only — never expose the secret key to the
# frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-key-here

# Folder used only as a legacy local fallback; product images are stored in
# Supabase Storage (see SUPABASE_* above), not on local disk
UPLOAD_DIR=./uploads

# Max upload size for a single product image, in bytes (default 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Store defaults (all of these are also editable later from /admin/settings)
STORE_NAME=John's Joyful Gifts
STORE_TAGLINE=Joyful Gifts for Every Little Moment
WHATSAPP_NUMBER=+910000000000
INSTAGRAM_URL=https://instagram.com/
DEFAULT_DELIVERY_CHARGE=49
FREE_DELIVERY_THRESHOLD=999

# Set to "production" to enable secure (HTTPS-only) cookies
ENVIRONMENT=development
